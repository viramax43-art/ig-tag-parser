#!/bin/bash
# Открывает список тегов для правки в текстовом редакторе.

cd "$(dirname "$0")" || exit 1
clear
echo "=============================================="
echo "  СПИСОК ТЕГОВ"
echo "=============================================="
echo

if [ ! -f data/tags.txt ]; then
    echo "тег1" > data/tags.txt
    echo "[i] Файл создан"
fi

echo "Сейчас в списке: $(grep -c . data/tags.txt | tr -d ' ') тегов"
echo
echo "ПРАВИЛА"
echo "  Один тег в одной строке, решётка не нужна."
echo "  Удалили строку — тег больше не собирается,"
echo "  но уже собранные по нему данные остаются."
echo "  Добавили строку — соберётся при следующем запуске."
echo "  Строки, начинающиеся с //, пропускаются."
echo
echo "[i] Открываю файл. Сохраните через Cmd+S и закройте окно."
echo

open -e data/tags.txt

echo
read -n 1 -s -r -p "Нажмите любую клавишу для выхода"
